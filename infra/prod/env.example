# Modelo de variáveis da homologação/produção. Copie para infra/prod/.env (que NÃO vai para o Git)
# e preencha com segredos gerados na própria VPS (ex.: openssl rand -base64 32).

SINEDU_VERSION=2026.11.18
SINEDU_DOMAIN=sinedu.com.br
ACME_EMAIL=infra@exemplo.com.br

# Desafio DNS para o certificado wildcard (*.sinedu.com.br). Plugin do Caddy: caddy-dns/<provedor>.
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=

# Rede interna do Docker em que o Caddy roda (docker network inspect sinedu_default).
DOCKER_NETWORK_CIDR=172.18.0.0/16

# PostgreSQL
POSTGRES_ADMIN_USER=sinedu_admin
POSTGRES_ADMIN_PASSWORD=
PLATFORM_DB_PASSWORD=
REGISTRY_READER_PASSWORD=
PGBOUNCER_AUTH_PASSWORD=

# Vault (tokens de AppRole emitidos no bootstrap — um por host, com as políticas de infra/vault/policies)
VAULT_PLATFORM_TOKEN=
VAULT_TENANT_TOKEN=

# SeaweedFS (S3)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OIDC
OIDC_TENANT_CLIENT_SECRET=
OIDC_PANEL_CLIENT_SECRET=
OIDC_CERTIFICATE_PASSWORD=

# SMTP do provedor contratado
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@sinedu.com.br

# Backups: chave PÚBLICA age (a privada fica fora da VPS, com quem pode restaurar)
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/sinedu
