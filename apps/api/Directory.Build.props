<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1515 (tornar tipos internos) não se aplica a módulos consumidos por outros assemblies -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA1716;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <!-- Bibliotecas de módulo usam tipos do ASP.NET Core (endpoints, middlewares) -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
